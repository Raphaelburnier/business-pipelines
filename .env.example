# Configuration du conseiller sur le PC. Copier vers .env et protéger le fichier.
# Le jeton est aléatoire, privé et différent de tout autre jeton du projet.
CONSEILLER_JETON=

# URL Tailnet HTTPS du cockpit NAS. L'agent ouvre seulement des connexions sortantes vers elle.
CONSEILLER_COCKPIT_URL=https://cockpit.votre-tailnet.ts.net

# Ollama est local, le cockpit ne reçoit jamais son URL ni une clé de modèle.
CONSEILLER_MODELE=qwen3:8b
CONSEILLER_OLLAMA_URL=http://127.0.0.1:11434
# CONSEILLER_HTTP_TIMEOUT_MS=30000 (délai d'un appel vers le cockpit, maximum 120000)
# CONSEILLER_OLLAMA_TIMEOUT_MS=120000 (délai d'un appel Ollama, repli compris, maximum 600000)
# Une valeur hors bornes arrête l'agent au démarrage.

# Vault Git local. Seules les notes déjà commitées sont indexées et synchronisées.
CONSEILLER_VAULT=/chemin/vers/Obsidian-Vault

# Intervalle du battement et synchronisation du RAG, en secondes.
CONSEILLER_PERIODE_S=20
CONSEILLER_SYNCHRO_S=300
