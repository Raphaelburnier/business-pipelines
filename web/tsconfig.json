{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@schemas/mission": ["../node_modules/agent-orchestrator/packages/schemas/mission.js"],
      "@schemas/plan": ["../node_modules/agent-orchestrator/packages/schemas/plan.js"],
      "@schemas/cockpit": ["../node_modules/agent-orchestrator/packages/schemas/cockpit.js"],
      "@schemas/modeles": ["../node_modules/agent-orchestrator/packages/schemas/modeles.js"],
      "@schemas/chat": ["../node_modules/agent-orchestrator/packages/schemas/chat.js"],
      "@schemas/livraison": ["../node_modules/agent-orchestrator/packages/schemas/livraison.js"]
    }
  },
  "include": ["src"]
}
