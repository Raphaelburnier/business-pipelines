{
  "name": "ajustement-prix",
  "description": "Propose des ajustements de prix à partir du marché observé, contrôle le plan de façon déterministe, puis exige une approbation humaine action par action. N'exécute rien : le pipeline s'arrête sur la liste approuvée.",
  "slicing": {
    "price-planner": [
      "marche",
      "strategie",
      "mes_annonces"
    ]
  },
  "budget": {
    "max_usd": 3,
    "max_total_turns": 60,
    "max_turns_per_agent": 30
  },
  "retry": {
    "max_fix_cycles": 2
  },
  "stages": [
    {
      "id": "collecte",
      "type": "fetch",
      "source": "ebay",
      "query_from": "marche",
      "limit": 50,
      "output": "listings.json"
    },
    {
      "id": "statistiques",
      "type": "stats",
      "against": "listings.json",
      "output": "stats.json"
    },
    {
      "id": "plan",
      "agents": [
        {
          "name": "price-planner",
          "inputs": [
            "listings.json",
            "stats.json"
          ],
          "outputs": [
            "actions.json"
          ],
          "output_schema": {
            "actions.json": {
              "actions": "array",
              "raisonnement": "array"
            }
          }
        }
      ]
    },
    {
      "id": "controle",
      "type": "verify-actions",
      "actions": "actions.json",
      "against": "listings.json",
      "owner": "plan",
      "output": "controle.json",
      "gate": {
        "report": "controle.json",
        "pass_when": {
          "field": "verdict",
          "equals": "VALIDE"
        },
        "fail_when": {
          "equals": [
            "INVALIDE"
          ]
        },
        "items": "manques",
        "targets": {
          "plan": "price-planner"
        },
        "rerun_from": "controle"
      }
    },
    {
      "id": "approbation",
      "type": "approval",
      "actions": "actions.json",
      "decisions": "ajustement-prix.decisions.json",
      "plan_gele": "ajustement-prix.plan.json",
      "collecte": "listings.json",
      "auto": [],
      "output": "approbation.json",
      "dossier": "ajustement-prix",
      "appliquer_avec": "ajustement-prix-appliquer"
    }
  ]
}
