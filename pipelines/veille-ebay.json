{
  "name": "veille-ebay",
  "description": "Veille concurrentielle en lecture seule sur eBay. Collecte et statistiques déterministes, analyse par agent limitée à l'interprétation, vérification déterministe de la couverture, des sources et des chiffres cités. Aucune action d'écriture n'existe dans ce pipeline.",
  "slicing": {
    "veille-analyst": [
      "questions",
      "marche"
    ]
  },
  "budget": {
    "max_usd": 2,
    "max_total_turns": 40,
    "max_turns_per_agent": 20
  },
  "retry": {
    "max_fix_cycles": 2
  },
  "stages": [
    {
      "id": "collecte",
      "type": "fetch",
      "source": "ebay",
      "query_from": "marche",
      "limit": 50,
      "output": "listings.json"
    },
    {
      "id": "statistiques",
      "type": "stats",
      "against": "listings.json",
      "output": "stats.json"
    },
    {
      "id": "analyse",
      "agents": [
        {
          "name": "veille-analyst",
          "inputs": [
            "listings.json",
            "stats.json"
          ],
          "outputs": [
            "veille-report.json"
          ],
          "output_schema": {
            "veille-report.json": {
              "reponses": "array",
              "questions_sans_reponse": "array"
            }
          }
        }
      ]
    },
    {
      "id": "verification",
      "type": "verify",
      "report": "veille-report.json",
      "against": "listings.json",
      "questions_from": "questions",
      "owner": "analyse",
      "output": "verification.json",
      "gate": {
        "report": "verification.json",
        "pass_when": {
          "field": "verdict",
          "equals": "COMPLETE"
        },
        "fail_when": {
          "equals": [
            "INCOMPLETE"
          ]
        },
        "items": "manques",
        "targets": {
          "analyse": "veille-analyst"
        },
        "rerun_from": "verification"
      },
      "stats": "stats.json"
    }
  ]
}
