# Gabarit du canal d'alerte. Copier en "alerte.env" et remplir.
# Le fichier rempli est gitignoré, ce gabarit ne l'est pas : n'y mets jamais de valeur.
#
# Contrairement aux autres .env de ce dossier, celui-ci n'appartient pas à un spec : un
# canal d'alerte est propre à l'installation, pas au marché suivi.

# Transport à utiliser. Sans lui, l'alerte échoue bruyamment plutôt que de ne rien
# envoyer : un canal muet ne se remarque que le jour où il comptait.
ALERTE_TRANSPORT=courriel

# Serveur SMTP. Le port décide du chiffrement : 465 pour le TLS implicite, 587 pour
# STARTTLS. Avec Gmail, le mot de passe est un mot de passe d'application, jamais celui
# du compte.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=

# Qui reçoit. L'expéditeur vaut l'utilisateur SMTP s'il n'est pas renseigné.
ALERTE_DESTINATAIRE=
# ALERTE_EXPEDITEUR=

# Adresse du cockpit, écrite dans le message. Tant que le cockpit n'écoute que sur la
# boucle locale, cette adresse ne vaut que depuis la machine elle-même : la laisser vide
# est plus honnête que d'envoyer un lien qui ne s'ouvrira pas depuis un téléphone.
# ALERTE_COCKPIT_URL=http://127.0.0.1:4600
