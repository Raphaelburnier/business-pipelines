# Configuration du cockpit d'approbation. Copier en specs/cockpit.env.
#
# Rien ici n'est un secret : ce fichier décrit qui peut parler au cockpit et sous quel
# nom les décisions sont signées. Il est quand même gitignoré comme les autres .env,
# parce que le nom d'un tailnet est une information d'infrastructure privée.

# Port d'écoute. Le tailnet passe par le relais, pas par ici.
COCKPIT_PORT=4600

# Adresse d'écoute. Ne la touche pas sur le poste : 127.0.0.1 est ce qui rend fiables les
# en-têtes d'identité que Tailscale injecte, et l'ouvrir sur le LAN laisserait n'importe
# quelle machine du réseau signer des décisions de prix sous ton nom.
#
# Le seul cas qui justifie autre chose est le conteneur, où lier la boucle locale rend le
# service injoignable même publié : la publication loopback de l'hôte prend alors le rôle.
# Les deux clés vont ensemble, le cockpit refuse de démarrer avec la première seule.
# Ces valeurs sont posées par docker-compose.yaml, pas ici.
# COCKPIT_HOTE=0.0.0.0
# COCKPIT_CONTENEUR=1

# Nom de cette machine dans le tailnet, sans schéma ni port.
# Le donner autorise ce nom dans la liste blanche d'hôtes et dans les origines acceptées.
# Le laisser vide garde le cockpit strictement local, comme avant.
# `bin/tailnet-relais.sh` affiche la valeur exacte à recopier.
COCKPIT_TAILNET=

# Nom qui signe les décisions prises depuis la console de la machine, là où personne
# n'a prouvé son identité. Vide, le compte système est utilisé, ce qui est au moins vrai.
# Les décisions venues du tailnet ignorent ce réglage : elles portent le login Tailscale.
COCKPIT_OPERATEUR_LOCAL=

# AI Instagram Studio. Le partage hôte d'archive est monté par Docker Compose ; par
# défaut /volume1/IAstudio sur ce NAS, surchargeable par AI_STUDIO_ARCHIVE_PATH.
AI_STUDIO_STORAGE_ROOT=/data/ai-studio-work
AI_STUDIO_ARCHIVE_ROOT=/data/ai-studio-archive
AI_STUDIO_MAX_CONCURRENT_JOBS=2

# ComfyUI reste sur le LAN ou un réseau Docker privé. Ne jamais publier cette URL dans le
# navigateur : seul le backend du Cockpit l'utilise.
COMFYUI_URL=http://adresse-privee-du-pc:8188

# Conseiller des approbations. Le NAS ne garde jamais le jeton lui-même : seulement son
# empreinte SHA-256. Générer cette valeur sur le PC avec :
# node -e "const c=require('crypto'); console.log(c.createHash('sha256').update(process.env.CONSEILLER_JETON).digest('hex'))"
# CONSEILLER_JETON_SHA256=
# CONSEILLER_BASE=/volume1/docker/business-pipelines/etat/conseiller.sqlite
