# Gabarit. Copier en "veille.env" (même nom que le spec, extension .env) et remplir.
# Le fichier rempli est gitignoré, ce gabarit ne l'est pas : n'y mets jamais de valeur.
#
# Convention du moteur : specs/veille.json  ->  specs/veille.env

# App ID et Cert ID de la console développeur eBay, section Sandbox.
# Ce sont des identifiants PERMANENTS : le code s'en sert pour fabriquer un token
# applicatif à la demande, et le remet en cache jusqu'à son expiration.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Échappatoire pour un essai à la main, avec un token collé depuis la console.
# Il expire en ~2 h, donc inutilisable pour quoi que ce soit de planifié.
# Renseigné, il court-circuite la fabrication ci-dessus.
# EBAY_OAUTH_TOKEN=

# Le sandbox est la cible par défaut. Ne décommenter que pour viser la production,
# délibérément, et en sachant que les identifiants de prod sont différents.
# EBAY_BASE_URL=https://api.ebay.com
