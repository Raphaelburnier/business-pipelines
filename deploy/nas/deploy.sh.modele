#!/bin/sh
# Bascule du cockpit sur la release @RELEASE@ (@VERSION@).
#
# Modèle rempli par bin/livrer.sh : ne pas lancer tel quel. Le script livré sur le NAS
# vérifie l'empreinte de l'archive, sauvegarde l'installation en place, construit les
# images, bascule, et restaure l'ancienne version si le cockpit ne repart pas.
# Steam TierList n'est pas concerné. À exécuter une fois :
#   sudo sh /volume1/docker/releases/@RELEASE@/deploy.sh
set -eu

BUSINESS=/volume1/docker/business-pipelines
RELEASE=/volume1/docker/releases/@RELEASE@
STAGE=$RELEASE/business-pipelines
ARCHIVE=$RELEASE/@ARCHIVE@
ENV=$BUSINESS/specs/deploiement.env
BACKUPS=/volume1/docker/business-pipelines-backups
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP=$BACKUPS/business-pipelines-before-@RELEASE@-$STAMP.tar.gz
# Le binaire de DSM sur l'hôte ; le livreur, dans son conteneur, pose DOCKER=/usr/bin/docker.
DOCKER=${DOCKER:-/usr/local/bin/docker}
BUILD_TIMEOUT_SEC=${LIVRAISON_BUILD_TIMEOUT_SEC:-2700}
SWITCH_TIMEOUT_SEC=${LIVRAISON_SWITCH_TIMEOUT_SEC:-600}
ROLLBACK_TIMEOUT_SEC=${LIVRAISON_ROLLBACK_TIMEOUT_SEC:-300}
COMMAND_TIMEOUT_SEC=${LIVRAISON_COMMAND_TIMEOUT_SEC:-120}
ARCHIVE_TIMEOUT_SEC=${LIVRAISON_ARCHIVE_TIMEOUT_SEC:-300}
STOP_GRACE_SEC=${LIVRAISON_STOP_GRACE_SEC:-5}
INCIDENT=$BUSINESS/etat/incident-livraison
MONITEUR=
SWITCHED=0
export COMPOSE_PROJECT_NAME=business-pipelines

# Chaque phase a une échéance commune ; chaque commande conserve aussi sa propre borne.
valider_budget() (
  budget=$1; maximum=$2
  case "$budget" in ''|0*|*[!0-9]*) echo "Budget invalide : $budget" >&2; return 2 ;; esac
  [ "$budget" -ge 1 ] && [ "$budget" -le "$maximum" ] || { echo "Budget hors limites : $budget (max $maximum s)" >&2; return 2; }
)
# /proc/uptime est monotone : une correction de l'heure du NAS ne prolonge pas un délai.
maintenant() { IFS=' ' read -r secondes reste < /proc/uptime; printf '%s\n' "${secondes%%.*}"; }
phase() { ETAPE_LIVRAISON=$1; PHASE_FIN=$(($(maintenant) + $2)); }
poser_incident() {
  mkdir -p "$BUSINESS/etat"
  printf '%s\n' "$1" > "$INCIDENT.$$.tmp"
  mv -f "$INCIDENT.$$.tmp" "$INCIDENT"
}

surveiller_commande() {
  budget=$1; maximum=$2; shift 2
  valider_budget "$budget" "$maximum" || exit 2
  fin=$(($(maintenant) + budget))
  [ "$fin" -le "$PHASE_FIN" ] || fin=$PHASE_FIN
  [ "$(maintenant)" -lt "$fin" ] || { echo "Échéance de phase atteinte : $ETAPE_LIVRAISON" >&2; exit 124; }
  pret=$(mktemp "$RELEASE/.commande.XXXXXX")
  groupe=
  lanceur=
  # Un zombie n'exécute plus de travail. Linux/WSL et DSM exposent l'état dans /proc.
  groupe_actif() (
    [ -n "$groupe" ] && kill -0 -"$groupe" 2>/dev/null || exit 1
    for stat in /proc/[0-9]*/stat; do
      IFS= read -r ligne 2>/dev/null < "$stat" || continue
      reste=${ligne##*) }
      set -f
      set -- $reste
      [ "${3:-}" = "$groupe" ] || continue
      case "$1" in Z|X) ;; *) exit 0 ;; esac
    done
    exit 1
  )
  arreter_groupe() {
    # Le signal peut arriver après l'accusé et avant sa lecture par la boucle principale.
    if [ -z "$groupe" ] && [ -s "$pret" ]; then IFS= read -r groupe < "$pret" || true; fi
    if [ -n "$groupe" ]; then
      kill -TERM -"$groupe" 2>/dev/null || true
      grace_fin=$(($(maintenant) + STOP_GRACE_SEC))
      while groupe_actif && [ "$(maintenant)" -lt "$grace_fin" ]; do sleep 0.05; done
      kill -KILL -"$groupe" 2>/dev/null || true
      confirmation_fin=$(($(maintenant) + 2))
      while groupe_actif && [ "$(maintenant)" -lt "$confirmation_fin" ]; do sleep 0.05; done
      if groupe_actif; then
        poser_incident "Arrêt d'un processus non confirmé après @RELEASE@. Livraison suspendue."
        return 125
      fi
    elif [ -n "$lanceur" ]; then
      kill -KILL -"$lanceur" 2>/dev/null || true
      kill -KILL "$lanceur" 2>/dev/null || true
    fi
    [ -z "$lanceur" ] || wait "$lanceur" 2>/dev/null || true
  }
  trap 'rm -f "$pret" "$pret.go"' EXIT
  trap 'arreter_groupe; exit 143' HUP INT TERM
  # La commande attend aussi l'autorisation retour : aucun travail ne démarre tant que
  # le moniteur n'a pas enregistré le groupe. Une interruption du handshake reste sans effet métier.
  setsid sh -c '
    pret=$1; shift
    [ -e "$pret" ] || exit 125
    printf "%s\n" "$$" > "$pret"
    attente=0
    while [ ! -e "$pret.go" ]; do
      [ -e "$pret" ] && [ "$attente" -lt 1000 ] || exit 125
      attente=$((attente + 1))
      sleep 0.01
    done
    exec "$@"' sh "$pret" "$@" &
  lanceur=$!
  while [ ! -s "$pret" ]; do
    if ! kill -0 "$lanceur" 2>/dev/null; then wait "$lanceur"; exit $?; fi
    if [ "$(maintenant)" -ge "$fin" ]; then arreter_groupe; exit 124; fi
    sleep 0.01
  done
  IFS= read -r groupe < "$pret"
  : > "$pret.go"
  while groupe_actif; do
    if [ "$(maintenant)" -ge "$fin" ]; then
      arreter_groupe || exit $?
      echo "Commande interrompue à l'étape $ETAPE_LIVRAISON : $1" >&2
      exit 124
    fi
    sleep 0.05
  done
  wait "$lanceur"
}
borne() {
  surveiller_commande "$@" &
  MONITEUR=$!
  if wait "$MONITEUR"; then resultat=0; else resultat=$?; fi
  MONITEUR=
  return "$resultat"
}
# L'interpolation du compose (docs/SECURITE-COMMANDES.md) vient de specs/, que la bascule
# garde ; un .env à la racine serait effacé par vider_code. Une seule variable, lue par motif
# et jamais sourcée.
if [ -f "$BUSINESS/specs/compose.env" ]; then
  COCKPIT_IDENTITE_SOCKET_SEULE=$(sed -n 's/^COCKPIT_IDENTITE_SOCKET_SEULE=\([01]\)$/\1/p' "$BUSINESS/specs/compose.env" | tail -n 1)
  export COCKPIT_IDENTITE_SOCKET_SEULE
fi

# Les versions précédentes n'ont ni maître séparé ni relais. Déterminer la liste depuis
# le code réellement en place couvre la première bascule et son retour arrière.
services_installes() {
  SERVICES="cockpit runner tailscale-whois publieur"
  for optionnel in maitre cockpit-relais; do
    if grep -q "^  $optionnel:" "$BUSINESS/docker-compose.yaml"; then SERVICES="$SERVICES $optionnel"; fi
  done
}
services_sains() {
  en_marche business_runner && en_marche business_tailscale_whois && en_marche business_publieur || return 1
  for optionnel in maitre cockpit-relais; do
    if grep -q "^  $optionnel:" "$BUSINESS/docker-compose.yaml"; then
      conteneur=$(printf '%s' "$optionnel" | tr '-' '_')
      en_marche "business_$conteneur" || return 1
    fi
  done
  if grep -q '^  maitre:' "$BUSINESS/docker-compose.yaml"; then
    borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" exec business_runner node -e 'fetch(`http://${process.env.ORCH_MAITRE_HOTE}:${process.env.ORCH_MAITRE_PORT || 650}/sante`,{signal:AbortSignal.timeout(2000)}).then(async r=>{if(!r.ok || (await r.json()).ok!==true)process.exit(1)}).catch(()=>process.exit(1))' || return 1
  fi
}
retirer_services() {
  CONTENEURS=
  # Un compose up peut échouer après n'avoir créé qu'une partie des conteneurs.
  for conteneur in business_cockpit business_runner business_tailscale_whois business_publieur business_maitre business_cockpit_relais; do
    if borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect "$conteneur" --format '{{.Image}}' > "$RELEASE/.image-optionnelle" 2>/dev/null; then CONTENEURS="$CONTENEURS $conteneur"; fi
  done
  [ -n "$CONTENEURS" ] || return 0
  borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" rm -f $CONTENEURS
}

en_marche() {
  borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect "$1" --format '{{.State.Running}}' > "$RELEASE/.etat-service" || return 1
  IFS= read -r etat_service < "$RELEASE/.etat-service" || return 1
  [ "$etat_service" = true ]
}
sante() {
  tentative=0
  while [ "$tentative" -lt 45 ] && [ "$(maintenant)" -lt "$PHASE_FIN" ]; do
    if borne "$COMMAND_TIMEOUT_SEC" 1800 curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:4600/ >/dev/null && \
      services_sains; then return 0; fi
    tentative=$((tentative + 1))
    sleep 1
  done
  return 1
}
rollback() {
  code=$1
  trap - EXIT HUP INT TERM
  set +e
  [ "$code" -ne 0 ] || code=1
  if [ -n "$MONITEUR" ]; then kill -TERM "$MONITEUR" 2>/dev/null; wait "$MONITEUR"; MONITEUR=; fi
  if [ "$SWITCHED" -eq 1 ]; then
    phase restaurer "$ROLLBACK_TIMEOUT_SEC"
    restauration_echec=0
    poser_incident "Restauration en cours après @RELEASE@. Livraison suspendue jusqu'à confirmation."
    echo "Échec après la bascule ; restauration du cockpit et du runner précédents..." >&2
    retirer_services >/dev/null 2>&1 || restauration_echec=1
    # Le code d'avant revient ; l'état en service n'est pas touché.
    vider_code || restauration_echec=1
    borne "$ARCHIVE_TIMEOUT_SEC" 900 tar -xzf "$BACKUP" -C /volume1/docker || restauration_echec=1
    # Les quatre services arrêtés reviennent sur leurs images d'avant : seuls le cockpit et le
    # runner étaient relancés, le relais d'identité et le publieur restaient arrêtés.
    borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" tag "$ANCIENNE_COCKPIT" business-pipelines-cockpit || restauration_echec=1
    borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" tag "$ANCIENNE_RUNNER" business-pipelines-runner || restauration_echec=1
    borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" tag "$ANCIENNE_WHOIS" business-pipelines-tailscale-whois || restauration_echec=1
    borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" tag "$ANCIENNE_PUBLIEUR" business-pipelines-publieur || restauration_echec=1
    for optionnel in maitre cockpit-relais; do
      case "$optionnel" in maitre) ancienne=$ANCIENNE_MAITRE ;; *) ancienne=$ANCIENNE_RELAIS ;; esac
      if [ -n "$ancienne" ]; then borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" tag "$ancienne" "business-pipelines-$optionnel" || restauration_echec=1; fi
    done
    cd "$BUSINESS" || restauration_echec=1
    if [ "$restauration_echec" -eq 0 ]; then
      services_installes
      borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" compose up -d --no-build $SERVICES && sante || restauration_echec=1
    fi
    if [ "$restauration_echec" -ne 0 ]; then
      poser_incident "Restauration non confirmée après @RELEASE@. Livraison suspendue."
      code=70
    else
      rm -f "$INCIDENT"
      echo "Restauration confirmée."
    fi
  else
    echo "Échec avant la bascule ; rien n'a été remplacé." >&2
  fi
  exit "$code"
}
trap 'rollback $?' EXIT
trap 'rollback 129' HUP
trap 'rollback 130' INT
trap 'rollback 143' TERM

if [ "$(id -u)" -ne 0 ]; then
  echo "Cette bascule doit être lancée avec sudo." >&2
  exit 1
fi
for requis in "$BUSINESS" "$ARCHIVE" "$ENV" "$BUSINESS/specs/workers.json" "$BUSINESS/specs/publieur.env" "$DOCKER"; do
  [ -e "$requis" ] || { echo "Élément requis absent : $requis" >&2; exit 1; }
done
command -v setsid >/dev/null || { echo "setsid est requis pour borner les processus de déploiement." >&2; exit 1; }
valider_budget "$BUILD_TIMEOUT_SEC" 7200
valider_budget "$SWITCH_TIMEOUT_SEC" 1800
valider_budget "$ROLLBACK_TIMEOUT_SEC" 900
valider_budget "$COMMAND_TIMEOUT_SEC" 1800
valider_budget "$ARCHIVE_TIMEOUT_SEC" 900
valider_budget "$STOP_GRACE_SEC" 30
[ ! -e "$INCIDENT" ] || { echo "Livraison suspendue : incident à résoudre dans $INCIDENT" >&2; exit 1; }
phase preparer "$BUILD_TIMEOUT_SEC"
# Ne pas vérifier ici les volumes du cockpit : le livreur exécute aussi ce script
# dans son propre conteneur, où le partage des modèles n'est pas monté.
printf '%s\n' "@SHA256@  $ARCHIVE" > "$RELEASE/.sha256"
borne "$ARCHIVE_TIMEOUT_SEC" 900 sha256sum -c "$RELEASE/.sha256"
# Le runner s'authentifie par l'abonnement (jeton) ou, à défaut, par une clé API.
grep -Eq '^(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=' "$ENV" || { echo "Ni jeton ni clé dans $ENV" >&2; exit 1; }

umask 077
borne "$COMMAND_TIMEOUT_SEC" 1800 rm -rf "$STAGE"
mkdir -p "$BACKUPS" "$STAGE"
borne "$ARCHIVE_TIMEOUT_SEC" 900 tar -xzf "$ARCHIVE" -C "$STAGE"
mkdir -p "$STAGE/specs"
ln -sf "$ENV" "$STAGE/specs/deploiement.env"
ln -sf "$BUSINESS/specs/workers.json" "$STAGE/specs/workers.json"
ln -sf "$BUSINESS/specs/publieur.env" "$STAGE/specs/publieur.env"

# L'état vit dans ces dossiers, et un déploiement n'y touche jamais : ni la sauvegarde ni la
# restauration ne les incluent. Archiver l'event store pendant qu'un service y écrit faisait
# échouer tar (« file changed as we read it », première livraison depuis le cockpit, le
# 2026-09-29) ; et restaurer cette copie en cas d'échec aurait remplacé l'état vivant par un
# instantané plus ancien, peut-être incohérent.
# Retire le code en place, garde l'état.
vider_code() {
  borne "$COMMAND_TIMEOUT_SEC" 1800 sh -c '
    for entree in "$1"/.[!.]* "$1"/..?* "$1"/*; do
      [ -e "$entree" ] || [ -L "$entree" ] || continue
      case "${entree##*/}" in approvals|specs|logs|runs|workspace|workspaces|etat|ai-studio-data|codex|run-cockpit|passer-abonnement.sh) continue ;; esac
      rm -rf "$entree" || exit $?
    done' sh "$BUSINESS"
}

borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect business_cockpit --format '{{.Image}}' > "$RELEASE/.image"
IFS= read -r ANCIENNE_COCKPIT < "$RELEASE/.image"
borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect business_runner --format '{{.Image}}' > "$RELEASE/.image"
IFS= read -r ANCIENNE_RUNNER < "$RELEASE/.image"
borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect business_tailscale_whois --format '{{.Image}}' > "$RELEASE/.image"
IFS= read -r ANCIENNE_WHOIS < "$RELEASE/.image"
borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect business_publieur --format '{{.Image}}' > "$RELEASE/.image"
IFS= read -r ANCIENNE_PUBLIEUR < "$RELEASE/.image"
# Les deux nouveaux services sont absents lors de la première migration.
ANCIENNE_MAITRE=
ANCIENNE_RELAIS=
if borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect business_maitre --format '{{.Image}}' > "$RELEASE/.image" 2>/dev/null; then IFS= read -r ANCIENNE_MAITRE < "$RELEASE/.image"; fi
if borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" inspect business_cockpit_relais --format '{{.Image}}' > "$RELEASE/.image" 2>/dev/null; then IFS= read -r ANCIENNE_RELAIS < "$RELEASE/.image"; fi
# Le code seulement : mêmes noms que vider_code, à garder d'accord.
borne "$ARCHIVE_TIMEOUT_SEC" 900 tar -czf "$BACKUP" -C /volume1/docker \
  --exclude=business-pipelines/approvals --exclude=business-pipelines/specs \
  --exclude=business-pipelines/logs --exclude=business-pipelines/runs \
  --exclude=business-pipelines/workspace --exclude=business-pipelines/workspaces \
  --exclude=business-pipelines/etat --exclude=business-pipelines/ai-studio-data \
  --exclude=business-pipelines/codex \
  --exclude=business-pipelines/run-cockpit --exclude=business-pipelines/passer-abonnement.sh \
  business-pipelines


echo "Construction des images..."
cd "$STAGE"
# Les quatre services ont le même `build: .`. Les construire ensemble lançait, avec le builder
# classique de DSM, la suite de tests jusqu'à quatre fois en parallèle : un cockpit de test
# qui démarrait en plus de 8 s faisait échouer la livraison (d017ae24, 2026-10-22). Une seule
# construction, puis la même image sous le nom de chaque service, que la bascule et la
# restauration utilisent.
borne "$BUILD_TIMEOUT_SEC" 7200 "$DOCKER" compose build cockpit
for service in runner tailscale-whois publieur maitre cockpit-relais; do
  borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" tag business-pipelines-cockpit "business-pipelines-$service"
done

echo "Bascule..."
phase basculer "$SWITCH_TIMEOUT_SEC"
poser_incident "Bascule en cours vers @RELEASE@. Contrôle des services attendu."
SWITCHED=1
retirer_services >/dev/null 2>&1
vider_code
borne "$ARCHIVE_TIMEOUT_SEC" 900 tar -xzf "$ARCHIVE" -C "$BUSINESS"
# Tout dossier monté par docker-compose.yaml doit exister : Docker sur DSM ne crée pas la
# source d'un bind mount, et la bascule échoue (./codex, 2026-10-15, version restaurée).
mkdir -p "$BUSINESS/approvals" "$BUSINESS/logs" "$BUSINESS/runs" "$BUSINESS/workspaces" "$BUSINESS/etat" "$BUSINESS/ai-studio-data" "$BUSINESS/codex" "$BUSINESS/run-cockpit" "$BUSINESS/specs/cles"
# deploiement.env n'est jamais réécrit ici : une réécriture en root l'a laissé lisible par
# tous le 2026-09-26. Ses droits sont seulement vérifiés.
# admindunas:users en numérique (1026:100, vérifié le 2026-09-29) : dans le conteneur du
# livreur, ces noms n'existent pas.
borne "$COMMAND_TIMEOUT_SEC" 1800 chown -R 1026:100 "$BUSINESS"
# Le relais tourne en root sans capacité DAC_OVERRIDE. Il doit pouvoir traverser le
# parent du socket, même si un ancien déploiement l'a laissé en 1026:100 / 700.
# Garder ce chemin d'identité privé, après le chown global et avant les services.
borne "$COMMAND_TIMEOUT_SEC" 1800 chown 0:0 "$BUSINESS/run-cockpit"
chmod 700 "$BUSINESS/run-cockpit"
# La connexion Codex du conseiller (auth.json) : lisible du seul propriétaire.
chmod 700 "$BUSINESS/codex"

cd "$BUSINESS"
services_installes
borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" compose up -d --no-build $SERVICES

if ! sante; then
  for service in cockpit runner tailscale_whois publieur maitre cockpit_relais; do borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" logs --tail 60 "business_$service" >&2 || true; done
  exit 1
fi
# L'image doit porter les deux correctifs dont les runs dépendent.
borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" exec business_runner sh -c 'command -v bash >/dev/null && git config --system --get-all safe.directory | grep -qx "/app/workspaces/\*"'
[ "$(stat -c %a "$ENV")" = "600" ] || { echo "Attention : $ENV n'est pas en 600." >&2; }
[ "$(stat -c %a "$BUSINESS/specs/publieur.env")" = "600" ] || { echo "Attention : specs/publieur.env n'est pas en 600." >&2; }
# Le premier passage du publieur : il doit avoir lu le dépôt GitHub sans erreur.
borne "$COMMAND_TIMEOUT_SEC" 1800 sleep 8
borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" logs --tail 5 business_publieur

borne "$COMMAND_TIMEOUT_SEC" 1800 "$DOCKER" ps --filter name=business_ --format '{{.Names}} : {{.Status}}'
borne "$COMMAND_TIMEOUT_SEC" 1800 curl -fsS --connect-timeout 2 --max-time 5 -o /dev/null -w 'Cockpit local : HTTP %{http_code}\n' http://127.0.0.1:4600/
rm -f "$INCIDENT"
trap - EXIT HUP INT TERM
echo "Déploiement terminé. Sauvegarde : $BACKUP"
