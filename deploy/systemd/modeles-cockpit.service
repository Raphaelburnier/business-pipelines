[Unit]
Description=Publie le catalogue OmniRoute vers le cockpit NAS
After=network-online.target omniroute.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/business-pipelines/modeles.env
ExecStart=%h/.local/bin/publier-modeles-cockpit
