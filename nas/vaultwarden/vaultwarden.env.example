# Copier en vaultwarden.env sur le NAS (chmod 600), à côté du docker-compose.yaml. Jamais commité.
#
# Les inscriptions ne se règlent plus ici : SIGNUPS_ALLOWED est fixé à false dans le
# docker-compose.yaml, qui l'emporte sur ce fichier.

# Hash argon2id du jeton du panneau /admin, jamais le jeton en clair.
#   1. Générer un jeton fort, le ranger dans Vaultwarden et sur papier : openssl rand -base64 48
#   2. Le hacher (la commande le demande deux fois) :
#        sudo -n /usr/local/bin/docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash --preset owasp
#   3. Coller la sortie ci-dessous.
# Guillemets simples obligatoires : le hash contient des $ que Compose interpréterait.
# Laisser vide désactive le panneau /admin : c'est encore plus strict, et on peut ne remplir
# cette ligne que le temps d'une opération d'admin.
ADMIN_TOKEN='$argon2id$...'
