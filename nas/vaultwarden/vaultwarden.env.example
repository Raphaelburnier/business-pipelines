# Copier en vaultwarden.env sur le NAS, à côté du docker-compose.yaml. Jamais commité.

# true le temps de créer ton compte, puis false et `docker compose up -d` : sinon toute
# machine du tailnet peut ouvrir un compte sur ton serveur.
SIGNUPS_ALLOWED=true

# Hash argon2 du jeton du panneau /admin, jamais le jeton en clair. Il se génère avec :
#   sudo docker run --rm -it vaultwarden/server /vaultwarden hash
# Guillemets simples obligatoires : le hash contient des $ que Compose interpréterait.
# Laisser vide désactive le panneau /admin, ce qui est aussi un choix valable.
ADMIN_TOKEN='$argon2id$...'
