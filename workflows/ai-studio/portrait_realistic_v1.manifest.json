{
  "id": "portrait_realistic_v1",
  "name": "Portrait realistic",
  "description": "Template texte-vers-image minimal pour portraits et scènes lifestyle. Les références ne sont pas encore injectées en Phase 1.",
  "workflow": "portrait_realistic_v1.json",
  "version": 1,
  "parameters": {
    "positive_prompt": { "type": "string", "required": true, "node": "6", "input": "text" },
    "negative_prompt": { "type": "string", "default": "", "node": "7", "input": "text" },
    "checkpoint": { "type": "string", "required": true, "node": "4", "input": "ckpt_name" },
    "seed": { "type": "integer", "min": 0, "max": 2147483647, "node": "3", "input": "seed" },
    "cfg": { "type": "number", "min": 1, "max": 15, "step": 0.1, "default": 5, "node": "3", "input": "cfg" },
    "steps": { "type": "integer", "min": 1, "max": 150, "step": 1, "default": 28, "node": "3", "input": "steps" },
    "sampler": { "type": "string", "enum": ["euler", "euler_ancestral", "dpmpp_2m", "dpmpp_2m_sde", "dpmpp_3m_sde"], "default": "dpmpp_2m", "node": "3", "input": "sampler_name" },
    "scheduler": { "type": "string", "enum": ["normal", "karras", "exponential", "sgm_uniform", "simple"], "default": "karras", "node": "3", "input": "scheduler" },
    "denoise": { "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 1, "node": "3", "input": "denoise" },
    "width": { "type": "integer", "min": 256, "max": 4096, "step": 8, "default": 832, "node": "5", "input": "width" },
    "height": { "type": "integer", "min": 256, "max": 4096, "step": 8, "default": 1040, "node": "5", "input": "height" },
    "filename_prefix": { "type": "string", "required": true, "node": "9", "input": "filename_prefix" }
  }
}
